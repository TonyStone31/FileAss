object DemoForm: TDemoForm
  Left = 24
  Height = 640
  Top = 24
  Width = 1000
  Caption = 'FileAss Demo'
  ClientHeight = 640
  ClientWidth = 1000
  Position = poDesigned
  DefaultMonitor = dmPrimary
  LCLVersion = '5.99.0.0'
  OnCreate = FormCreate
  object ActionsPanel: TPanel
    Left = 0
    Height = 164
    Top = 0
    Width = 1000
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 164
    ClientWidth = 1000
    TabOrder = 0
    object RegisterButton: TButton
      Left = 16
      Height = 36
      Top = 12
      Width = 340
      Caption = '1. Register File Types on This System'
      TabOrder = 0
      OnClick = RegisterButtonClick
    end
    object ValidateButton: TButton
      Left = 372
      Height = 36
      Top = 12
      Width = 300
      Caption = '2. Verify System Registration'
      TabOrder = 1
      OnClick = ValidateButtonClick
    end
    object MenuEntry: TCheckBox
      Left = 696
      Height = 22
      Hint = 'Include a launcher when you register or export; removal removes it too'
      Top = 18
      Width = 244
      Caption = 'Add to Applications menu (Linux)'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 2
    end
    object NoteIcon: TImage
      Cursor = crHandPoint
      Left = 16
      Height = 48
      Hint = 'Show this sample in the system file manager'
      Top = 68
      Width = 48
      ParentShowHint = False
      Proportional = True
      ShowHint = True
      Stretch = True
      OnClick = SampleIconClick
    end
    object NoteLabel: TLabel
      Cursor = crHandPoint
      Left = 76
      Height = 17
      Top = 82
      Width = 179
      Caption = '3. Find Blue Note (.fanote)'
      OnClick = SampleIconClick
    end
    object SketchIcon: TImage
      Cursor = crHandPoint
      Left = 394
      Height = 48
      Hint = 'Show this sample in the system file manager'
      Top = 68
      Width = 48
      ParentShowHint = False
      Proportional = True
      ShowHint = True
      Stretch = True
      OnClick = SampleIconClick
    end
    object SketchLabel: TLabel
      Cursor = crHandPoint
      Left = 454
      Height = 17
      Top = 82
      Width = 216
      Caption = '3. Find Amber Sketch (.fasketch)'
      OnClick = SampleIconClick
    end
    object HintLabel: TLabel
      Left = 16
      Height = 17
      Top = 132
      Width = 849
      Caption = 'Click an icon to select its sample in your file manager, then double-click the file. Use Open With to choose this demo if needed.'
    end
  end
  object UtilitiesPanel: TPanel
    Left = 0
    Height = 60
    Top = 580
    Width = 1000
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 60
    ClientWidth = 1000
    TabOrder = 2
    object RemoveButton: TButton
      Left = 12
      Height = 36
      Top = 12
      Width = 242
      Caption = 'Remove Demo Registration'
      TabOrder = 0
      OnClick = RemoveButtonClick
    end
    object DefaultsButton: TButton
      Left = 262
      Height = 36
      Top = 12
      Width = 300
      Caption = 'System Default Applications...'
      TabOrder = 1
      OnClick = DefaultsButtonClick
    end
    object GenerateButton: TButton
      Left = 570
      Height = 36
      Hint = 'Export files for packaging; this does not install associations'
      Top = 12
      Width = 300
      Caption = 'Export Association Files...'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 2
      OnClick = GenerateButtonClick
    end
  end
  object Pages: TPageControl
    Left = 0
    Height = 416
    Top = 164
    Width = 1000
    ActivePage = ResultsTab
    Align = alClient
    TabIndex = 0
    TabOrder = 1
    object ResultsTab: TTabSheet
      Caption = 'Registration'
      ClientHeight = 388
      ClientWidth = 998
      object ResultsMemo: TMemo
        Left = 0
        Height = 388
        Top = 0
        Width = 998
        Align = alClient
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
        WordWrap = False
      end
    end
    object OpenedTab: TTabSheet
      Caption = 'Files Received by This Instance'
      ClientHeight = 388
      ClientWidth = 998
      object InstanceLabel: TLabel
        Left = 0
        Height = 40
        Top = 0
        Width = 998
        Align = alTop
        AutoSize = False
        Caption = 'Keep this window open, then open more sample files. New launches forward their files to this instance and exit.'
        WordWrap = True
      end
      object OpenedMemo: TMemo
        Left = 0
        Height = 348
        Top = 40
        Width = 998
        Align = alClient
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
        WordWrap = False
      end
    end
  end
  object FileAssMan: TFileAssMan
    ApplicationID = 'org.example.fileass.demo'
    ApplicationName = 'FileAss Demo'
    ApplicationDescription = 'FileAss document opening demonstration'
    SupportsMultipleFiles = True
    FileTypes = <
      item
        Extension = '.fanote'
        Description = 'FileAss Blue Note'
        MimeType = 'application/x-fileass-demo-note'
        TypeIdentifier = 'org.example.fileass.demo.note'
        WindowsIcon = 'icons/blue-note.ico'
        LinuxIcon = 'icons/blue-note.svg'
        OpenArguments = '--'
      end
      item
        Extension = '.fasketch'
        Description = 'FileAss Amber Sketch'
        MimeType = 'application/x-fileass-demo-sketch'
        TypeIdentifier = 'org.example.fileass.demo.sketch'
        WindowsIcon = 'icons/amber-sketch.ico'
        LinuxIcon = 'icons/amber-sketch.svg'
        OpenArguments = '--'
      end>
    Left = 758
    Top = 64
  end
  object FileAssInstance: TFileAssInstance
    Mode = fimForwardParameters
    OnParameters = StartupParameters
    Enabled = True
    FileAssMan = FileAssMan
    Left = 888
    Top = 63
  end
end
